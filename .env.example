# Supabase Configuration (Phase 1)
# Find these in your Supabase Dashboard -> Project Settings -> API
# Use the anon / publishable key in the frontend. NEVER put the service_role key here!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key

# Backend API Endpoint
VITE_API_URL=http://localhost:5000/api

# Store Owner WhatsApp Number (without '+' sign, e.g. 916382240715)
VITE_STORE_PHONE_NUMBER=916382240715

# Owner UPI ID for Customer Direct UPI Payments
VITE_OWNER_UPI_ID=916382240715@upi
VITE_OWNER_UPI_NAME= Ghajanas

